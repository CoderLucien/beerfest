# Copy to .env and fill in your TiDB Starter connection values.
# Do NOT commit .env (it is gitignored).
DB_HOST=gateway01.example.pingkai.cn
DB_PORT=4000
DB_USER=your_cluster_id.root
DB_PASSWORD=your_password
DB_NAME=beerfest
DB_TLS=tidb

# LLM config for ops chat bot (Tencent Hunyuan or compatible API)
LLM_API_KEY=sk-your-key-here
