# ─────────────────────────────────────────────────────────────────────
# 路径 A（推荐）：TiDB Cloud Serverless —— 生产/客户部署
#   1. 在 https://tidbcloud.com 创建免费 Serverless 集群
#   2. 从集群「Connect」面板复制连接信息，填入下方变量
#   3. cp .env.example docker/.env 后执行 docker compose -f docker/docker-compose.yml up -d
# ─────────────────────────────────────────────────────────────────────
# 路径 B（开发/试玩）：本地 MySQL 8，无需 .env
#   docker compose -f docker/docker-compose.yml -f docker/docker-compose.dev.yml up -d
#   （dev 凭据仅存在于 docker-compose.dev.yml，勿用于生产）
# ─────────────────────────────────────────────────────────────────────
# Do NOT commit .env (it is gitignored).

DB_HOST=your-tidb-cloud-host
DB_PORT=4000
DB_USER=your_cluster_id.root
DB_PASSWORD=your_password
DB_NAME=beerfest
DB_TLS=tidb

# 可选：管理员初始密码（不设置则随机生成一次性密码并打印在 api 启动日志）
# ADMIN_INIT_PASSWORD=change-me

# LLM config for ops chat bot (Tencent Hunyuan or compatible API)
LLM_API_KEY=sk-your-key-here
# LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# LLM_MODEL=hunyuan-lite
